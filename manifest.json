{
  "manifest_version": 3,
  "name": "PromptLens — Image to AI Prompt",
  "short_name": "PromptLens",
  "version": "1.12.1",
  "description": "Hover, right-click, or select several images at once to generate detailed AI art prompts using Groq, Gemini, or Mistral vision models. Includes Adobe Stock metadata auto-fill.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "contextMenus",
    "storage",
    "scripting",
    "activeTab",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://contributor.stock.adobe.com/*"],
      "js": ["constants.js", "adobe-stock.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://stock.adobe.com/contributor/*",
        "https://stock.adobe.com/*/contributor/*"
      ],
      "js": ["adobe-contributor-profile.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "PromptLens"
  },
  "options_page": "options.html",
  "minimum_chrome_version": "110"
}
